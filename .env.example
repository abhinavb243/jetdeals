# Copy to .env and fill in. Never commit .env.
# OpenSky Network API client (opensky-network.org -> Account -> API Client)
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
# SEC EDGAR requires a descriptive User-Agent with a contact, e.g. "JetDeal research yourname@example.com"
SEC_USER_AGENT=
# Folder with the unzipped FAA ReleasableAircraft database (MASTER.txt, ACFTREF.txt)
FAA_REGISTRY_DIR=
# Optional tuning
ALERT_SCORE_THRESHOLD=60
